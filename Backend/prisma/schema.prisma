generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                String          @id @default(uuid())
  email             String          @unique
  name              String
  createdAt         DateTime        @default(now())
  location          String?
  password          String
  role              UserRole?
  donations         Donation[]      @relation("DonorDonations")
  receivedDonations Donation[]      @relation("ReceivedDonations")
  notifications     Notification[]
  requests          Request[]       @relation("UserRequests")
  volunteerTasks    VolunteerTask[] @relation("VolunteerAssignments")
}

model Donation {
  id             String          @id @default(uuid())
  title          String
  description    String
  category       Category
  quantity       Int
  status         DonationStatus  @default(AVAILABLE)
  createdAt      DateTime        @default(now())
  donorId        String
  recipientId    String?
  donor          User            @relation("DonorDonations", fields: [donorId], references: [id])
  recipient      User?           @relation("ReceivedDonations", fields: [recipientId], references: [id])
  volunteerTasks VolunteerTask[]
}

model Request {
  id          String        @id @default(uuid())
  title       String
  description String
  category    Category
  quantity       Int
  status      RequestStatus @default(OPEN)
  createdAt   DateTime      @default(now())
  recipientId String
  recipient   User          @relation("UserRequests", fields: [recipientId], references: [id])
}

model VolunteerTask {
  id          String     @id @default(uuid())
  status      TaskStatus @default(PENDING)
  createdAt   DateTime   @default(now())
  volunteerId String
  donationId  String
  donation    Donation   @relation(fields: [donationId], references: [id])
  volunteer   User       @relation("VolunteerAssignments", fields: [volunteerId], references: [id])
}

model Notification {
  id          String   @id @default(uuid())
  userId      String
  message     String
  type        String?
  referenceId String?
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id])
}

enum UserRole {
  DONOR
  RECIPIENT
  VOLUNTEER
  ADMIN
}

enum DonationStatus {
  AVAILABLE
  CLAIMED
  DELIVERED
}

enum RequestStatus {
  OPEN
  FULFILLED
}

enum TaskStatus {
  PENDING
  COMPLETED
}

enum Category {
  FOOD
  CLOTHES
  SUPPLIES
  OTHER
}
